s=input()
lower=[]
upper=[]
odd=[]
even=[]

for i in (s):
    if i.islower():
        lower.append(i)
    elif i.isupper():
        upper.append(i)
    elif i.isdigit():
        if int(i)%2==1:
            odd.append(i)
        else :
            even.append(i)        
        
print(''.join(sorted(lower)+(sorted(upper)+sorted(odd)+sorted(even)))) 
